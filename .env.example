# Copy to .env for local testing. On Render, set these as environment variables
# in the service dashboard (or in render.yaml) instead of committing a real .env file.

# Used to sign/verify client auth tokens (HMAC). Generate a long random value.
# e.g. openssl rand -hex 32
SERVER_SECRET=change-me-to-a-long-random-secret

# Path to the SQLite database file. On Render this should point at a mounted
# persistent disk (see render.yaml) so data survives deploys/restarts.
DATABASE_URL=./data/sdmesh.db

NODE_ENV=production

# Render sets PORT automatically; this is only used for local runs.
PORT=3000
